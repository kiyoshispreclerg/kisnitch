# Kisnitch build configuration. Override any variable on the command line,
# e.g. `make CC=clang PREFIX=/usr TLS=1`.

VERSION          = 0.2.0
UPSTREAM_VERSION = 1.8.0
FULL_VERSION     = $(VERSION)+os$(UPSTREAM_VERSION)

# Install paths (used from phase 11 on).
PREFIX     ?= /usr/local
BINDIR     ?= $(PREFIX)/bin
SBINDIR    ?= $(PREFIX)/sbin
SYSCONFDIR ?= /etc
DATADIR    ?= $(PREFIX)/share
SYSTEMDDIR ?= $(PREFIX)/lib/systemd/system
DESTDIR    ?=

# Optional features (0 = off, 1 = on). TLS=1: TLS between daemon and UI
# (OpenSSL). EBPF isn't wired yet (phase 9).
TLS    ?= 0
EBPF   ?= 0
NOTIFY ?= 0
# NOTIFY=1: desktop notifications (ui/notify.c) with libnotify.
# CURL=1: the "downloader" task (daemon/tasks/downloader.c) with libcurl.
CURL   ?= 0

CC         ?= cc
AR         ?= ar
PKG_CONFIG ?= pkg-config

# C11 without GNU extensions; POSIX.1-2008 for strdup, open_memstream, etc.
STDFLAGS  = -std=c11 -D_POSIX_C_SOURCE=200809L
WARNFLAGS = -Wall -Wextra -Werror -Wpedantic -Wshadow -Wformat=2 \
            -Wstrict-prototypes -Wmissing-prototypes -Wvla
# Vendored third-party code is built with the base warnings only.
VENDOR_WARNFLAGS = -Wall -Wextra -Werror

OPTFLAGS ?= -O2 -g
CPPFLAGS += -I. -Icommon/vendor/cjson -DKS_VERSION='"$(FULL_VERSION)"' \
            -DKS_UPSTREAM_VERSION='"$(UPSTREAM_VERSION)"'
LDLIBS   += -pthread

# Required libraries.
PCRE2_CFLAGS := $(shell $(PKG_CONFIG) --cflags libpcre2-8)
PCRE2_LIBS   := $(shell $(PKG_CONFIG) --libs libpcre2-8)
CPPFLAGS += $(PCRE2_CFLAGS)
LDLIBS   += $(PCRE2_LIBS)

# Interception (phase 3): nfqueue, and nftables through libnftnl + libmnl.
NETFILTER_PKGS   = libnetfilter_queue libnftnl libmnl
NETFILTER_CFLAGS := $(shell $(PKG_CONFIG) --cflags $(NETFILTER_PKGS))
NETFILTER_LIBS   := $(shell $(PKG_CONFIG) --libs $(NETFILTER_PKGS))
CPPFLAGS += $(NETFILTER_CFLAGS)
LDLIBS   += $(NETFILTER_LIBS)

# Daemon <-> UI protocol (phase 5): gRPC over nghttp2, messages with
# protobuf-c (common/pb/ is generated by tools/sync-proto.sh).
PROTO_PKGS   = libnghttp2 libprotobuf-c
PROTO_CFLAGS := $(shell $(PKG_CONFIG) --cflags $(PROTO_PKGS))
PROTO_LIBS   := $(shell $(PKG_CONFIG) --libs $(PROTO_PKGS))
CPPFLAGS += $(PROTO_CFLAGS)
LDLIBS   += $(PROTO_LIBS)

# UI (phase 6+): GLib for the library part (testable without a display),
# GTK 2 for kisnitch-gtk. Their headers go in with -isystem: our warning
# flags are not for them.
UI_PKGS     = glib-2.0 sqlite3
GTK_PKGS    = gtk+-2.0
UI_CFLAGS  := $(patsubst -I%,-isystem %,$(shell $(PKG_CONFIG) --cflags $(UI_PKGS)))
UI_LIBS    := $(shell $(PKG_CONFIG) --libs $(UI_PKGS)) -lm
GTK_CFLAGS := $(patsubst -I%,-isystem %,$(shell $(PKG_CONFIG) --cflags $(GTK_PKGS)))
GTK_LIBS   := $(shell $(PKG_CONFIG) --libs $(GTK_PKGS)) -lm

# `make asan` sets SANITIZE=1.
SANITIZE ?= 0
ifeq ($(SANITIZE),1)
OPTFLAGS = -O1 -g -fno-omit-frame-pointer
SANFLAGS = -fsanitize=address,undefined -fno-sanitize-recover=all
endif

ifeq ($(CURL),1)
CURL_CFLAGS := $(shell $(PKG_CONFIG) --cflags libcurl)
CURL_LIBS   := $(shell $(PKG_CONFIG) --libs libcurl)
CPPFLAGS += -DKS_HAVE_CURL $(CURL_CFLAGS)
LDLIBS   += $(CURL_LIBS)
endif

ifeq ($(NOTIFY),1)
GTK_PKGS   += libnotify
GTK_CFLAGS := $(patsubst -I%,-isystem %,$(shell $(PKG_CONFIG) --cflags $(GTK_PKGS))) -DKS_HAVE_NOTIFY
GTK_LIBS   := $(shell $(PKG_CONFIG) --libs $(GTK_PKGS)) -lm
endif

ifeq ($(TLS),1)
TLS_CFLAGS := $(shell $(PKG_CONFIG) --cflags openssl)
TLS_LIBS   := $(shell $(PKG_CONFIG) --libs openssl)
CPPFLAGS += -DKS_HAVE_TLS $(TLS_CFLAGS)
LDLIBS   += $(TLS_LIBS)
endif
