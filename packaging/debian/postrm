#!/bin/sh
set -e

case "$1" in
remove)
    [ -d /run/systemd/system ] && systemctl --system daemon-reload >/dev/null || true
    ;;
purge)
    # /etc/opensnitchd belongs to OpenSnitch too: it stays.
    if [ -x /usr/bin/deb-systemd-helper ]; then
        deb-systemd-helper purge kisnitch.service >/dev/null || true
        deb-systemd-helper unmask kisnitch.service >/dev/null || true
    fi
    update-rc.d kisnitch remove >/dev/null || true
    ;;
esac
exit 0
