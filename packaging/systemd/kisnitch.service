[Unit]
Description=Kisnitch application firewall (OpenSnitch port)
Documentation=https://github.com/evilsocket/opensnitch/wiki
Wants=network.target
After=network.target
# Same configuration and rules as the original daemon: only one can run
Conflicts=opensnitch.service

[Service]
Type=simple
ExecStart=/usr/sbin/kisnitchd -rules-path /etc/opensnitchd/rules
Restart=always
RestartSec=30
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
