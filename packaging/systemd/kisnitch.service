[Unit]
Description=Kisnitch application firewall (OpenSnitch port)
Documentation=https://github.com/evilsocket/opensnitch/wiki
Wants=network.target
After=network.target
# Same configuration and rules as the original daemon: only one can run
Conflicts=opensnitch.service

[Service]
Type=simple
ExecStart=/usr/sbin/kisnitchd -rules-path /etc/opensnitchd/rules
Restart=always
RestartSec=30
TimeoutStopSec=10

# Hardening (docs/PRIVILEGES.md says why each line is there). The daemon runs
# as root but with only the capabilities it uses:
#   CAP_NET_ADMIN    nfqueue, nftables, the process connector
#   CAP_NET_RAW      iptables (only with "Firewall": "iptables")
#   CAP_SYS_PTRACE   /proc/PID/{exe,fd,cwd,environ} of other users' processes
#   CAP_DAC_OVERRIDE connecting to the GUI's socket (the user's, mode 0640),
#                    reading the executables it checksums
# The audit method runs auditctl and the ebpf method (not ported) loads
# programs: they need more (CAP_AUDIT_CONTROL); add it in a drop-in.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_OVERRIDE
NoNewPrivileges=yes
# /usr, /boot and /etc are read-only, except where the daemon keeps its state.
# If Rules.Path or the system firewall file are elsewhere in /etc, list them in
# a drop-in: ReadWritePaths=/etc/other/rules
ProtectSystem=full
ReadWritePaths=/etc/opensnitchd
ProtectHome=read-only
# no PrivateTmp: the GUI's socket is /tmp/osui.sock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
