#!/bin/sh
### BEGIN INIT INFO
# Provides:          kisnitch
# Required-Start:    $remote_fs $network $syslog
# Required-Stop:     $remote_fs $network $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Kisnitch application firewall daemon
# Description:       Kisnitch (OpenSnitch port): intercepts outgoing
#                    connections and asks the GUI what to do.
### END INIT INFO

PATH=/sbin:/usr/sbin:/bin:/usr/bin
NAME=kisnitch
DAEMON=/usr/sbin/kisnitchd
PIDFILE=/run/$NAME.pid
RULES=/etc/opensnitchd/rules
DAEMON_ARGS="-rules-path $RULES"
[ -r /etc/default/$NAME ] && . /etc/default/$NAME

[ -x "$DAEMON" ] || exit 0
. /lib/lsb/init-functions

do_start() {
    # the original daemon uses the same files; never run both
    if pidof opensnitchd >/dev/null 2>&1; then
        log_failure_msg "opensnitchd is running; stop it first"
        return 1
    fi
    [ -d "$RULES" ] || mkdir -p "$RULES"
    start-stop-daemon --start --quiet --oknodo --background --make-pidfile \
        --pidfile "$PIDFILE" --exec "$DAEMON" -- $DAEMON_ARGS
}

do_stop() {
    # SIGTERM: the daemon removes its firewall rules before exiting
    start-stop-daemon --stop --quiet --oknodo --retry=TERM/10/KILL/5 \
        --pidfile "$PIDFILE" --exec "$DAEMON"
    rc=$?
    rm -f "$PIDFILE"
    return $rc
}

case "$1" in
start)
    log_daemon_msg "Starting Kisnitch" "$NAME"
    do_start
    log_end_msg $?
    ;;
stop)
    log_daemon_msg "Stopping Kisnitch" "$NAME"
    do_stop
    log_end_msg $?
    ;;
restart|force-reload)
    log_daemon_msg "Restarting Kisnitch" "$NAME"
    do_stop
    do_start
    log_end_msg $?
    ;;
status)
    status_of_proc -p "$PIDFILE" "$DAEMON" "$NAME"
    exit $?
    ;;
*)
    echo "Usage: /etc/init.d/$NAME {start|stop|restart|force-reload|status}" >&2
    exit 3
    ;;
esac
exit 0
